<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/wsc
        http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd">

    <configuration defaultErrorHandler-ref="ticket-rest-error-handler"/>
    <configuration-properties file="application.properties"/>

    <http:listener-config name="rest-listener-config">
        <http:listener-connection host="${http.host}" port="${http.port}"/>
    </http:listener-config>

    <wsc:config name="ticket-soap-config">
        <wsc:connection wsdlLocation="${ticket.soap.wsdl}"
                        service="TicketsPortService"
                        port="TicketsPortSoap11"
                        address="${ticket.soap.endpoint}"
                        mtomEnabled="true"/>
    </wsc:config>

    <flow name="health-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/health"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
        </http:listener>

        <set-payload mimeType="application/json"
                     value='#[output application/json --- {
                         status: "UP",
                         service: p("app.name")
                     }]'/>
    </flow>

    <flow name="get-tickets-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
            output application/xml
            ns t http://soa.ifmo.ru/ticket/ws
            var sortValues = attributes.queryParams.*sort
            var filterValues = attributes.queryParams.*filter
            ---
            t#getTicketsRequest: {
                t#page: attributes.queryParams.page default 0,
                t#size: attributes.queryParams.size default 10,
                (t#sort: sortValues) if (!isEmpty(sortValues)),
                (t#filter: filterValues) if (!isEmpty(filterValues))
        }]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="getTickets"/>

        <set-variable variableName="soapTickets" value='#[%dw 2.0
            output application/java
            ns t http://soa.ifmo.ru/ticket/ws
            var body = payload.body
            ---
            body.t#getTicketsResponse.t#tickets.*t#ticket]'/>
        <flow-ref name="ticket-list-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST GET /api/v1/tickets -> SOAP getTickets completed successfully"/>
    </flow>

    <flow name="get-ticket-with-max-type-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/max-type"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload mimeType="application/xml"
                     value='#[%dw 2.0
import mapMaxTypeRequest from dataweave::MaxTypeRequest
output application/xml
---
mapMaxTypeRequest()]'/>
        <wsc:consume config-ref="ticket-soap-config" operation="getTicketWithMaxType"/>
        <set-variable variableName="soapTicket" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#getTicketWithMaxTypeResponse.t#ticket]'/>
        <flow-ref name="ticket-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST GET /api/v1/tickets/max-type -> SOAP getTicketWithMaxType completed successfully"/>
    </flow>

    <flow name="get-tickets-by-comment-substring-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/comment-contains"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
output application/xml
ns t http://soa.ifmo.ru/ticket/ws
---
t#getTicketsByCommentSubstringRequest: {
    t#substring: attributes.queryParams.substring
}]'/>
        <wsc:consume config-ref="ticket-soap-config"
                     operation="getTicketsByCommentSubstring"/>
        <set-variable variableName="soapTickets" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body
    .t#getTicketsByCommentSubstringResponse.t#tickets.*t#ticket]'/>
        <flow-ref name="ticket-list-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST GET /api/v1/tickets/comment-contains -> SOAP getTicketsByCommentSubstring completed successfully"/>
    </flow>

    <flow name="get-tickets-with-type-greater-than-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/type-greater-than"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
import mapTicketsAboveTypeRequest from dataweave::TicketsAboveTypeRequest
output application/xml
---
mapTicketsAboveTypeRequest(attributes)]'/>
        <wsc:consume config-ref="ticket-soap-config"
                     operation="getTicketsWithTypeGreaterThan"/>
        <set-variable variableName="soapTickets" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body
    .t#getTicketsWithTypeGreaterThanResponse.t#tickets.*t#ticket]'/>
        <flow-ref name="ticket-list-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST GET /api/v1/tickets/type-greater-than -> SOAP getTicketsWithTypeGreaterThan completed successfully"/>
    </flow>

    <flow name="get-ticket-by-id-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/{id}"
                       allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-variable variableName="ifNoneMatch"
                      value="#[attributes.headers.'if-none-match' default null]"/>
        <set-payload value='#[%dw 2.0
output application/xml
ns t http://soa.ifmo.ru/ticket/ws
---
t#getTicketByIdRequest: {
    t#id: attributes.uriParams.id
}]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="getTicketById"/>

        <set-variable variableName="etag" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#getTicketByIdResponse.t#etag as String]'/>

        <choice>
            <when expression="#[vars.ifNoneMatch != null and vars.ifNoneMatch == vars.etag]">
                <set-variable variableName="httpStatus" value="304"/>
                <set-variable variableName="outboundHeaders" value='#[{"ETag": vars.etag}]'/>
                <set-payload value="#[null]"/>
            </when>
            <otherwise>
                <set-variable variableName="httpStatus" value="200"/>
                <set-variable variableName="outboundHeaders"
                              value='#[{
                                  "Content-Type": "application/json; charset=UTF-8",
                                  "ETag": vars.etag
                              }]'/>
                <set-payload value='#[%dw 2.0
import mapGetTicketResponse from dataweave::GetTicketResponse
output application/json skipNullOn="objects"
---
mapGetTicketResponse(payload)]'/>
            </otherwise>
        </choice>
        <logger level="INFO"
                message="REST GET /api/v1/tickets/{id} -> SOAP getTicketById completed successfully"/>
    </flow>

    <flow name="download-ticket-pdf-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/{id}/pdf"
                       allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
output application/xml
ns t http://soa.ifmo.ru/ticket/ws
---
t#downloadTicketRequest: {
    t#id: attributes.uriParams.id
}]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="downloadTicket"/>

        <set-variable variableName="pdfFileName" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#downloadTicketResponse.t#fileName as String]'/>
        <set-variable variableName="outboundHeaders"
                      value='#[{
                          "Content-Type": "application/pdf",
                          "Content-Disposition": "attachment; filename=\"" ++ vars.pdfFileName ++ "\""
                      }]' />
        <set-payload value="#[payload.attachments[0]]"
                     mimeType="application/pdf"/>
        <logger level="INFO"
                message="REST GET /api/v1/tickets/{id}/pdf -> SOAP downloadTicket completed successfully"/>
    </flow>

    <flow name="create-ticket-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets"
                       allowedMethods="POST" doc:name="Listener">
            <http:response statusCode="201">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
import mapCreateTicketRequest from dataweave::CreateTicketRequest
output application/xml
---
mapCreateTicketRequest(attributes)]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="createTicket"/>
        <set-variable variableName="soapTicket" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#createTicketResponse.t#ticket]'/>
        <flow-ref name="ticket-response-to-json-subflow"/>
        <set-variable variableName="outboundHeaders"
                      value='#[{
                          "Content-Type": "application/json; charset=UTF-8",
                          "Location": "/api/v1/tickets/" ++ (payload.id as String)
                      }]'/>
        <logger level="INFO"
                message="REST POST /api/v1/tickets -> SOAP createTicket completed successfully; ticketId=#[payload.id]"/>
    </flow>

    <flow name="update-ticket-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/{id}"
                       allowedMethods="PUT">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
import mapUpdateTicketRequest from dataweave::UpdateTicketRequest
output application/xml
---
mapUpdateTicketRequest(attributes)]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="updateTicket"/>
        <set-variable variableName="soapTicket" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#updateTicketResponse.t#ticket]'/>
        <flow-ref name="ticket-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST PUT /api/v1/tickets/{id} -> SOAP updateTicket completed successfully; ticketId=#[payload.id]"/>
    </flow>

    <flow name="patch-ticket-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/{id}"
                       allowedMethods="PATCH">
            <http:response statusCode="200">
                <http:headers>#[{"Content-Type": "application/json; charset=UTF-8"}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
import mapPatchTicketRequest from dataweave::PatchTicketRequest
output application/xml
---
mapPatchTicketRequest(attributes)]'/>

        <wsc:consume config-ref="ticket-soap-config" operation="patchTicket"/>
        <set-variable variableName="soapTicket" value='#[%dw 2.0
output application/java
ns t http://soa.ifmo.ru/ticket/ws
---
payload.body.t#patchTicketResponse.t#ticket]'/>
        <flow-ref name="ticket-response-to-json-subflow"/>
        <logger level="INFO"
                message="REST PATCH /api/v1/tickets/{id} -> SOAP patchTicket completed successfully; ticketId=#[payload.id]"/>
    </flow>

    <flow name="delete-ticket-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets/{id}"
                       allowedMethods="DELETE">
            <http:response statusCode="204"/>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-payload value='#[%dw 2.0
output application/xml
ns t http://soa.ifmo.ru/ticket/ws
---
t#deleteTicketRequest: {
    t#id: attributes.uriParams.id
}]'/>
        <wsc:consume config-ref="ticket-soap-config" operation="deleteTicket"/>
        <logger level="INFO"
                message="REST DELETE /api/v1/tickets/{id} -> SOAP deleteTicket completed successfully"/>
        <set-payload value="#[null]"/>
    </flow>

    <flow name="options-tickets-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/tickets"
                       allowedMethods="OPTIONS">
            <http:response statusCode="204">
                <http:headers>#[{"Allow": "GET, POST, OPTIONS"}]</http:headers>
            </http:response>
        </http:listener>
        <set-payload value="#[null]"/>
    </flow>

    <sub-flow name="ticket-response-to-json-subflow">
        <set-payload value='#[%dw 2.0
import mapTicketResponse from dataweave::TicketResponse
output application/json skipNullOn="objects"
---
mapTicketResponse(vars)]'/>
    </sub-flow>

    <sub-flow name="ticket-list-response-to-json-subflow">
        <set-payload value='#[%dw 2.0
import mapTicketListResponse from dataweave::TicketListResponse
output application/json skipNullOn="objects"
---
mapTicketListResponse(vars)]'/>
    </sub-flow>

    <error-handler name="ticket-rest-error-handler">
        <on-error-propagate type="WSC:SOAP_FAULT" logException="true">
            <set-variable variableName="soapFault" value='#[%dw 2.0
import mapSoapFaultDetails from dataweave::SoapFaultDetails
output application/java
---
mapSoapFaultDetails(error)]'/>

            <set-variable variableName="httpStatus" value="#[vars.soapFault.status]"/>
            <logger level="ERROR"
                    message="SOAP fault mapped to HTTP #[vars.soapFault.status]: #[vars.soapFault.code] - #[vars.soapFault.message]"/>
            <set-variable variableName="outboundHeaders"
                          value='#[{"Content-Type": "application/json; charset=UTF-8"}]'/>
            <set-payload value='#[%dw 2.0
                output application/json skipNullOn="objects"
                var status = vars.soapFault.status
                var errorName =
                    if (status == 400) "Bad Request"
                    else if (status == 404) "Not Found"
                    else if (status == 409) "Conflict"
                    else if (status == 422) "Unprocessable Content"
                    else "Internal Server Error"
                ---
                {
                    timestamp: (now() >> "UTC") as String {format: "dd.MM.yyyy HH:mm:ss"},
                    status: status,
                    error: errorName,
                    message: vars.soapFault.message,
                    path: attributes.requestPath,
                    (violations: [{
                        field: vars.soapFault.field,
                        message: vars.soapFault.message
                    }]) if (vars.soapFault.field != null)
                }]'/>
        </on-error-propagate>
    </error-handler>

    <flow name="rest-api-fallback-flow">
        <http:listener config-ref="rest-listener-config"
                       path="/api/v1/*">
            <http:response statusCode="#[vars.httpStatus default 404]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <set-variable variableName="httpStatus" value="404"/>
        <set-variable variableName="outboundHeaders"
                      value='#[{"Content-Type": "application/json; charset=UTF-8"}]'/>
        <set-payload mimeType="application/json"
                     value='#[%dw 2.0
import mapRouteNotFound from dataweave::RouteNotFound
output application/json
---
mapRouteNotFound(attributes)]'/>
    </flow>
</mule>
